# Configurações do FFmpeg Build
# Copie este arquivo para .env e ajuste conforme necessário

# === CONFIGURAÇÕES DO USUÁRIO ===
# Estas configurações são capturadas automaticamente se não especificadas

# IDs do usuário (capturado automaticamente com: id -u / id -g)
USER_ID=$(id -u)
GROUP_ID=$(id -g)

# Nome do usuário (capturado automaticamente com: whoami)
USERNAME=$(whoami)

# === CONFIGURAÇÕES DE BUILD ===

# Versão do Ubuntu a usar (24.04, 22.04, 20.04, 18.04, etc.)
#UBUNTU_VERSION=24.04

# Modo de build: compile (compilar FFmpeg) ou runtime (apenas executar)
#BUILD_MODE=compile

# Timezone
#TZ=America/Maceio

# === CONFIGURAÇÕES DE MODO DE OPERAÇÃO ===

# Modo manutenção: true = não executa build automático, vai direto para shell
#MAINTENANCE_MODE=false

# Manter container ativo: true = não sai após build, mantém shell disponível
#KEEP_ALIVE=false

# Limpeza automática: true = remove arquivos temporários após build bem-sucedido
#AUTO_CLEAN=false

# === CONFIGURAÇÕES AVANÇADAS ===

# Opções de build do FFmpeg (padrão: --optimize=y)
# Opções disponíveis:
#   --libs-only=y        # Compilar apenas bibliotecas
#   --ffmpeg-only=y      # Compilar apenas FFmpeg
#   --extras=y           # Compilar MediaInfo e MP4Box
#   --optimize=y         # Compilar versão otimizada
# Exemplos:
#   FFMPEG_BUILD_OPTS="--optimize=y"
#   FFMPEG_BUILD_OPTS="--libs-only=y"
#   FFMPEG_BUILD_OPTS="--ffmpeg-only=y --optimize=y"
#   FFMPEG_BUILD_OPTS="--extras=y --optimize=n"
#FFMPEG_BUILD_OPTS=--optimize=y

# Configurações adicionais do FFmpeg (opcional - DEPRECATED, use FFMPEG_BUILD_OPTS)
#FFMPEG_OPTS=--optimize=y

# Habilitar CUDA se disponível (true/false)
#ENABLE_CUDA=true

# Níveis de log (error, warn, info, debug)
#LOG_LEVEL=info